      "answer": {
        "kind": "choice",
        "options_fa": [
          "بله، تاریخ قانون قطعی است",
          "بله، فقط با نمودار بیشتر",
          "خیر؛ سناریوها و شواهد جاری باید جدا ارزیابی شوند"
        ],
