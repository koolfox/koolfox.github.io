      "lines": [
        "Neocognitron: Key Ingredients",
        "Fukushima, 1980.",
        "Simple cells extract",
        "local features using",
        "a sliding filter:"
      ]
    },
    {
      "number": 16,
      "source_text_sha256": "4f2a6b547d1d930bab35920ccec9d709a90a82aa91326ca52b30eefc631868c8",
      "lines": [
        "Neocognitron: Key Ingredients",
        "Fukushima, 1980.",
        "Complex cells fire",
        "when any part of the",
        "local region is the",
        "desired pattern"
      ]
    },
