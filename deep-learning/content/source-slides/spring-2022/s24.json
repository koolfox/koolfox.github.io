        "✓",
        "Ex⇠pdata log pmodel(x | ✓)",
        "Fully-visible belief net",
        "pmodel(x)= pmodel(x1)",
        "Y",
        "n",
        "i=2",
        "pmodel(xi | x1,...,xi￾1)",
        "Change of variables",
        "y = g(x) ) px(x)= py(g(x))",
        "￾",
        "￾",
        "￾",
        "￾",
        "det ✓@g(x)",
        "@x",
        "◆￾",
        "￾",
        "￾",
        "￾",
