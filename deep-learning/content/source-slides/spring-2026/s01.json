      "lines": [
        "Introductions",
        "Instructor: Danna Gurari; aka, Dr. G (she/her)",
        "Teaching assistants (will hold office hours):",
        "Everley Tseng (she/her) Nick Cooper (he/him) Jarek Reynolds (he/him) Nolan Brady (he/him)"
      ]
