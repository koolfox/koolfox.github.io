; Educational short run; not a convergence or biological result.
integrator = md
dt = 0.002
nsteps = 50000
nstxout-compressed = 500
nstenergy = 500
nstlog = 500
cutoff-scheme = Verlet
coulombtype = PME
rcoulomb = 1.0
rvdw = 1.0
constraints = h-bonds
constraint-algorithm = lincs
pbc = xyz
tcoupl = V-rescale
tc-grps = System
tau-t = 0.1
ref-t = 300
define = -DPOSRES
pcoupl = no
continuation = no
gen-vel = yes
gen-temp = 300
gen-seed = 42
